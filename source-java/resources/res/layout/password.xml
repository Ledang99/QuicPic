<?xml version="1.0" encoding="utf-8"?>
<com.alensw.p038ui.view.PasswordView xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="300dp">
    <com.alensw.p038ui.view.LockPatternView
        android:id="@+id/pattern"
        android:layout_width="300dp"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="36sp"
        android:textColor="?attr/colorThemeIcon"
        android:gravity="center"
        android:id="@+id/pin_code"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:password="true"
        android:inputType="phone"/>
    <GridView
        android:gravity="center"
        android:id="@+id/grid"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:verticalSpacing="32dp"
        android:numColumns="3"/>
</com.alensw.p038ui.view.PasswordView>

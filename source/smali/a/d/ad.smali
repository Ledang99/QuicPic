.class La/d/ad;
.super La/d/b;


# direct methods
.method constructor <init>(La/d/u;)V
    .locals 1

    invoke-direct {p0, p1}, La/d/b;-><init>(La/d/u;)V

    const/16 v0, 0x74

    iput-byte v0, p0, La/d/ad;->g:B

    return-void
.end method


# virtual methods
.method n([BI)I
    .locals 1

    const/4 v0, 0x0

    return v0
.end method

.method o([BI)I
    .locals 1

    const/4 v0, 0x0

    return v0
.end method

.method p([BI)I
    .locals 1

    const/4 v0, 0x0

    return v0
.end method

.method q([BI)I
    .locals 1

    const/4 v0, 0x0

    return v0
.end method

.class La/d/ce;
.super La/d/at;


# direct methods
.method constructor <init>()V
    .locals 1

    invoke-direct {p0}, La/d/at;-><init>()V

    const/16 v0, 0x8

    iput-byte v0, p0, La/d/ce;->L:B

    return-void
.end method


# virtual methods
.method a([BII)I
    .locals 1

    const/4 v0, 0x0

    return v0
.end method

.method b([BII)I
    .locals 1

    const/4 v0, 0x0

    return v0
.end method

<?xml version="1.0" encoding="utf-8"?>
<com.alensw.ui.view.TitleBar android:id="@id/title_bar" style="@style/ToolBar.Top"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <com.alensw.ui.view.HomeButton android:id="@id/home" style="@style/ActionButton.Home" />
    <FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_weight="1.0">
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:paddingRight="2.0dip" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" style="@style/ActionItem">
            <com.alensw.ui.view.TitleView android:textSize="@dimen/action_text_size" android:ellipsize="end" android:id="@android:id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" />
            <TextView android:textSize="@dimen/action_subtitle_size" android:ellipsize="end" android:id="@id/subtitle" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/action_subtitle_top_margin" android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <ProgressBar android:id="@id/circular" android:visibility="gone" android:layout_width="@dimen/progress_size" android:layout_height="@dimen/progress_size" style="?android:progressBarStyleSmallTitle" />
    <com.alensw.ui.view.ActionLayout android:id="@id/container" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/ToolBar">
        <ImageView android:id="@id/menu" style="@style/ActionButton.Overflow" />
    </com.alensw.ui.view.ActionLayout>
</com.alensw.ui.view.TitleBar>

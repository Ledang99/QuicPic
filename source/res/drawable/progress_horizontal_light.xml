<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:drawable="@drawable/progress_horizontal_background" />
    <item android:id="@android:id/secondaryProgress" android:drawable="@drawable/progress_horizontal_secondary" />
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="line">
                <size android:height="3.0dip" android:width="3.0dip" />
                <stroke android:width="3.0dip" android:color="@color/material_background_dark" />
            </shape>
        </scale>
    </item>
</layer-list>

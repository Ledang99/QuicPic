<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Blue" parent="@style/Theme.Monet.Base.Dark">
        <item name="android:colorAccent">@color/monet_accent_black</item>
        <item name="colorActionBar">@color/monet_bar_dark_color</item>
        <item name="colorBackground">@color/monet_background_dark_color</item>
        <item name="colorForeground">@color/monet_foreground_dark_color</item>
        <item name="colorElevation">@color/monet_elevation_dark</item>
        <item name="colorAccentInverse">@color/monet_accent_light</item>
    </style>
    <style name="Theme.DarkColor" parent="@style/Theme.Base.Dark">
        <item name="android:alertDialogTheme">@style/Theme.Dialog.Alert.Color.Dark</item>
        <item name="android:colorAccent">?android:textColorPrimary</item>
        <item name="colorActionBar">@color/material_background_black</item>
        <item name="colorBackground">@color/material_background_black</item>
        <item name="colorForeground">@color/material_foreground_black_color</item>
        <item name="colorElevation">?colorForeground</item>
        <item name="colorAccentInverse">?colorForeground</item>
        <item name="colorDrawableIcon">?android:textColorSecondary</item>
        <item name="colorDialog">@color/material_foreground_black_color</item>
        <item name="colorThemeIcon">?android:textColorPrimary</item>
        <item name="colorTrackOn">@color/track_on_color_dark_color</item>
        <item name="colorTrackOff">@color/track_off_color_dark_color</item>
        <item name="colorTrackLine">@color/track_line_color_dark_color</item>
        <item name="colorThumbOn">@color/thumb_on_color_dark_color</item>
        <item name="colorThumbOff">@color/thumb_off_color_dark_color</item>
    </style>
    <style name="Theme.LightColor" parent="@style/Theme.Base.Dark">
        <item name="android:alertDialogTheme">@style/Theme.Dialog.Alert.Color.Dark</item>
        <item name="android:colorAccent">?android:textColorPrimary</item>
        <item name="colorActionBar">@color/material_background_dark_color</item>
        <item name="colorBackground">@color/material_background_dark_color</item>
        <item name="colorForeground">@color/material_foreground_dark_color</item>
        <item name="colorElevation">?colorForeground</item>
        <item name="colorAccentInverse">?colorForeground</item>
        <item name="colorDrawableIcon">?android:textColorSecondary</item>
        <item name="colorDialog">@color/material_foreground_dark_color</item>
        <item name="colorThemeIcon">?android:textColorPrimary</item>
        <item name="colorTrackOn">@color/track_on_color_dark_color</item>
        <item name="colorTrackOff">@color/track_off_color_dark_color</item>
        <item name="colorTrackLine">@color/track_line_color_dark_color</item>
        <item name="colorThumbOn">@color/thumb_on_color_dark_color</item>
        <item name="colorThumbOff">@color/thumb_off_color_dark_color</item>
    </style>
    <style name="LaunchScreen" parent="@style/Theme.Monet.Base.Dark">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/monet_background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
